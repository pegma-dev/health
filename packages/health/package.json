{
  "name": "@pegma/health",
  "version": "0.1.0",
  "description": "Composable health probes and HTTP responses for Pegma hosts.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pegma-dev/health.git",
    "directory": "packages/health"
  },
  "dependencies": {
    "@pegma/spine": "0.1.1",
    "@pegma/storage-core": "0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  }
}
